SECRET_KEY=
FROGENT_DATABASE_URI=
FROGENT_HOST=127.0.0.1
FROGENT_PORT=5000
FROGENT_MEMORY_DB=runtime/app/research-memory.sqlite3
# FROGENT Agent uses one frozen arm: DeepSeek V4 Flash or Codex Luna with max reasoning.
FROGENT_LLM_BACKEND=deepseek
FROGENT_DEEPSEEK_MODEL=deepseek-v4-flash
FROGENT_DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# Blank or 0 disables the DeepSeek wall-clock cutoff.
FROGENT_DEEPSEEK_TIMEOUT=
# Blank or 0 disables the wall-clock cutoff; a positive finite value enables a deployment override.
FROGENT_CODEX_TIMEOUT=
FROGENT_CODEX_EXECUTABLE=/Applications/ChatGPT.app/Contents/Resources/codex
FROGENT_CODEX_MODEL=gpt-5.6-luna
FROGENT_CODEX_REASONING_EFFORT=max
FROGENT_MAX_READERS=4
FROGENT_MAX_QUERIES=12
FROGENT_MAX_RESULTS_PER_QUERY=10
FROGENT_MAX_READER_DOCUMENTS=6
FROGENT_MAX_EXPANSION_QUERIES=6
FROGENT_MAX_MEMORY_HITS=8
FROGENT_MAX_MEMORY_PROMPT_CHARS=8000
FROGENT_PUBMED_EMAIL=
FROGENT_PUBMED_TOOL=frogent
NCBI_API_KEY=
OPENALEX_API_KEY=
UNPAYWALL_EMAIL=
# Optional project-contained dynamic docking tools; set all three together.
FROGENT_VINA_EXECUTABLE=
FROGENT_MEEKO_LIGAND_EXECUTABLE=
FROGENT_MEEKO_RECEPTOR_EXECUTABLE=
FROGENT_VINA_VERSION=1.2.7
FROGENT_MEEKO_VERSION=0.7.1
# Optional project-contained PLIP executable for explicitly selected dynamic poses.
FROGENT_PLIP_EXECUTABLE=
FROGENT_PLIP_VERSION=3.0.0
# Comma-separated exact HETATM identities explicitly approved for receptor removal.
FROGENT_DOCKING_REMOVABLE_COMPONENTS=
# Optional pH-aware ligand states. Once enabled, every field is required explicitly.
FROGENT_DIMORPHITE_EXECUTABLE=
FROGENT_DIMORPHITE_VERSION=
FROGENT_LIGAND_PH_MIN=
FROGENT_LIGAND_PH_MAX=
FROGENT_LIGAND_PH_PRECISION=
FROGENT_MAX_PROTOMERS=
FROGENT_MAX_TAUTOMERS=
# Optional receptor state. PDB2PQR and propka3 must share one contained venv/bin.
FROGENT_PDB2PQR_EXECUTABLE=
FROGENT_PROPKA_EXECUTABLE=
FROGENT_PDB2PQR_VERSION=
FROGENT_PROPKA_VERSION=
FROGENT_RECEPTOR_PH=
FROGENT_PDB2PQR_FORCE_FIELD=
# Private TrioWorkspace stdio MCP. Defaults target the configured doomx_3nd SSH alias.
FROGENT_TRIO_SSH_HOST=doomx_3nd
FROGENT_TRIO_SSH_EXECUTABLE=ssh
FROGENT_TRIO_REMOTE_PYTHON=/work/doomx/TrioWorkspace/runtime/envs/control-plane/current/bin/python
FROGENT_TRIO_USER_ID=frogent-mcp
FROGENT_TRIO_USER_EMAIL=frogent-mcp@localhost.invalid
FROGENT_TRIO_MAX_ARTIFACT_BYTES=20971520
# Blank or 0 keeps SSH/task waiting free of a fixed wall-clock cutoff.
FROGENT_TRIO_SSH_TIMEOUT=
