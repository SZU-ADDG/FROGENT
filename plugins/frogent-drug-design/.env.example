SECRET_KEY=
FROGENT_DATABASE_URI=
FROGENT_HOST=127.0.0.1
FROGENT_PORT=5000
FROGENT_MEMORY_DB=.runtime/app-v4/research-memory.sqlite3
# Blank or 0 disables the wall-clock cutoff; a positive finite value enables a deployment override.
FROGENT_CODEX_TIMEOUT=
FROGENT_CODEX_EXECUTABLE=codex
FROGENT_MAX_READERS=4
FROGENT_MAX_QUERIES=12
FROGENT_MAX_RESULTS_PER_QUERY=10
FROGENT_MAX_READER_DOCUMENTS=6
FROGENT_MAX_EXPANSION_QUERIES=6
FROGENT_MAX_MEMORY_HITS=8
FROGENT_MAX_MEMORY_PROMPT_CHARS=8000
FROGENT_PUBMED_EMAIL=
FROGENT_PUBMED_TOOL=frogent
NCBI_API_KEY=
OPENALEX_API_KEY=
UNPAYWALL_EMAIL=
# Optional project-contained dynamic docking tools; set all three together.
FROGENT_VINA_EXECUTABLE=
FROGENT_MEEKO_LIGAND_EXECUTABLE=
FROGENT_MEEKO_RECEPTOR_EXECUTABLE=
FROGENT_VINA_VERSION=1.2.7
FROGENT_MEEKO_VERSION=0.7.1
# Optional project-contained PLIP executable for explicitly selected dynamic poses.
FROGENT_PLIP_EXECUTABLE=
FROGENT_PLIP_VERSION=3.0.0
# Comma-separated exact HETATM identities explicitly approved for receptor removal.
FROGENT_DOCKING_REMOVABLE_COMPONENTS=
