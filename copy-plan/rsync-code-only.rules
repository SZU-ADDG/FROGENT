# FROGENT code-only selective-copy rules.
# First-match wins. Destructive rsync flags are forbidden by AGENTS.md.

# Version-control metadata and editor state.
- .git/
- .hg/
- .svn/
- .idea/
- .vscode/

# Generated caches, dependency trees, builds, and runtime output.
- __pycache__/
- .pytest_cache/
- .mypy_cache/
- .ruff_cache/
- .ipynb_checkpoints/
- .tox/
- node_modules/
- .venv/
- venv/
- env/
- dist/
- build/
- coverage/
- cache/
- tmp/
- temp/
- log/
- logs/
- uploads/
- workspace/
- results/
- runs/
- output/
- outputs/
- test_output/
- docked_conformations/
- database/

# Known large MCP datasets, generated jobs, bundled runtimes, and model assets.
- /mcp-toolset/DirectMultiStep/data/
- /mcp-toolset/Trio-pep/targets/
- /mcp-toolset/CBGBench/checkpoints/
- /mcp-toolset/p2rank_2.5/bin/
- /mcp-toolset/p2rank_2.5/models/
- /mcp-toolset/p2rank_2.5/test_data/
- /mcp-toolset/mdockpep2.1/GLPR-*/
- /mcp-toolset/mdockpep2.1/*-test_peptide/
- /mcp-toolset/mdockpep2.1/HLA-M1/
- /mcp-toolset/mdockpep2.1/4ZGM-test_peptide/
- /mcp-toolset/mdockpep2.1/MGLTools-1.5.6/
- /mcp-toolset/mdockpep2.1/mgltools_x86_64Linux2_1.5.6/
- /mcp-toolset/mdockpep2.1/modeller-9.13/

# Secret-bearing files are withheld from the initial refactoring copy.
- .env
- .env.*
- *.pem
- *.key
- id_rsa*

# Preserve the small, curated FROGENT sample inputs.
+ /files/***
+ /上传文件示例/***
+ /上传文件示例1/***

# Traverse all remaining directories so source files can be selected below.
+ */

# Extensionless project metadata and entry files.
+ .gitignore
+ .dockerignore
+ .gitattributes
+ README*
+ CHANGELOG*
+ LICENSE*
+ COPYING*
+ NOTICE*
+ Makefile
+ CMakeLists.txt
+ Dockerfile*
+ Procfile
+ Snakefile
+ screen_command

# Source code and notebooks.
+ *.py
+ *.pyi
+ *.ipynb
+ *.js
+ *.jsx
+ *.mjs
+ *.cjs
+ *.ts
+ *.tsx
+ *.vue
+ *.svelte
+ *.java
+ *.kt
+ *.kts
+ *.scala
+ *.go
+ *.rs
+ *.rb
+ *.php
+ *.swift
+ *.lua
+ *.pl
+ *.pm
+ *.R
+ *.r
+ *.jl
+ *.m
+ *.mm
+ *.c
+ *.h
+ *.cc
+ *.cpp
+ *.cxx
+ *.hpp
+ *.cu
+ *.cuh
+ *.f
+ *.f90
+ *.sh
+ *.bash
+ *.zsh
+ *.fish
+ *.ps1
+ *.bat
+ *.cmd
+ *.proto
+ *.graphql
+ *.gql

# Configuration, dependency manifests, templates, and documentation.
+ *.toml
+ *.yaml
+ *.yml
+ *.json
+ *.xml
+ *.ini
+ *.cfg
+ *.conf
+ *.config
+ *.properties
+ *.gradle
+ *.lock
+ *.txt
+ *.md
+ *.markdown
+ *.rst
+ *.tex
+ *.html
+ *.htm
+ *.css
+ *.scss
+ *.sass
+ *.less

# Frontend and documentation assets.
+ *.png
+ *.jpg
+ *.jpeg
+ *.gif
+ *.svg
+ *.ico
+ *.webp
+ *.woff
+ *.woff2
+ *.ttf
+ *.eot

# Everything else remains on the server.
- *
