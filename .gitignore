# Local secrets
.env
.env.*
!.env.example

# Python caches and tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/

# Local runtime output
runtime/*
!runtime/README.md
*.log
logs/
tmp/
uploads/
artifacts/

# Databases, model weights, and generated heavy assets
*.db
*.sqlite
*.sqlite3
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
*.bin
checkpoints/
weights/

# Local editor and operating-system files
.DS_Store
.idea/
.vscode/

# Local LaTeX build products (source figures remain tracked explicitly)
docs/manuscript/revision-source/*.aux
docs/manuscript/revision-source/*.bbl
docs/manuscript/revision-source/*.blg
docs/manuscript/revision-source/*.fdb_latexmk
docs/manuscript/revision-source/*.fls
docs/manuscript/revision-source/*.out
docs/manuscript/revision-source/main.pdf
docs/manuscript/revision-source/sup.pdf
docs/manuscript/revision-source/main-marked.pdf
